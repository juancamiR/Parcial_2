<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.techsolutions.viewController.PrincipalViewController"
            style="-fx-background-color: #f4f6f9; -fx-font-family: 'Segoe UI', System;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #1e293b; -fx-padding: 14 24 14 24;">
            <VBox spacing="2">
                <Label text="TechSolutions S.A.S. — Sistema de Gestión de Servicios Tecnológicos"
                       style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="profe subame 0.1 puntos porque lo hice solito"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Universidad del Quindío · Programación II"
                   style="-fx-text-fill: #38bdf8; -fx-font-size: 12px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabPanePrincipal" tabClosingPolicy="UNAVAILABLE" style="-fx-padding: 8;">
            <tabs>
                <Tab text="1. Catálogo y Personalización de Servicios">
                    <content>
                        <fx:include fx:id="serviciosView" source="ServiciosView.fxml"/>
                    </content>
                </Tab>
                <Tab text="2. Configuración de Paquetes Tecnológicos">
                    <content>
                        <fx:include fx:id="paquetesView" source="PaquetesView.fxml"/>
                    </content>
                </Tab>
                <Tab text="3. Registro de Solicitudes de Servicio">
                    <content>
                        <fx:include fx:id="solicitudesView" source="SolicitudesView.fxml"/>
                    </content>
                </Tab>
                <Tab text="4. Consulta de Técnicos y Confirmación">
                    <content>
                        <fx:include fx:id="consultasTecnicosView" source="ConsultasTecnicosView.fxml"/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
